# Required OCI credentials for oracle-oci-cloud-mcp.
# Variable NAMES only. Do NOT commit real values (.env is git-ignored).
#
# The entrypoint refuses to start unless all five are set.
# Values are passed to `docker run -e <NAME>`; they are never baked into the image.

# OCI tenancy OCID (ocid1.tenancy.oc1..)
OCI_TENANCY=

# OCI user OCID (ocid1.user.oc1..)
OCI_USER=

# API key fingerprint (aa:bb:cc:...)
OCI_FINGERPRINT=

# OCI region identifier, e.g. eu-frankfurt-1
OCI_REGION=

# Base64 (single line) of the PEM API private key.
# The entrypoint decodes it to a 0600 temp file at runtime and unsets it.
OCI_PRIVATE_KEY_B64=

# Optional / not required by this entrypoint (present in some environments):
# OCI_HOME_REGION=
# OCI_COMPARTMENT_ID=
